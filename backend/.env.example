# Database
DATABASE_URL=postgresql+asyncpg://placement_user:placement_pass@localhost:5432/placement_portal

# Security
SECRET_KEY=change-this-to-a-64-character-random-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM
LLM_PROVIDER=google
LLM_API_KEY=your-api-key-here
LLM_MODEL=gemini-2.0-flash

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000

# File Uploads
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=./uploads

# Agent Config
MAX_RETRIES=3
TOKEN_BUDGET=100000
RUN_TIMEOUT_SECONDS=300

# Coding-platform connectors
# GitHub: optional token raises the API limit from 60 to 5,000 requests/hour (read-only, no scopes needed)
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
# LeetCode has no official public API; this is its public GraphQL endpoint and may change without notice
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
CONNECTOR_TIMEOUT_SECONDS=10
CODING_DATA_STALE_HOURS=24

# Knowledge base retrieval: postgres_fts (default, no extensions) or pgvector (needs the vector extension + AWS Bedrock)
KB_BACKEND=postgres_fts

# Run checkpoints (resume interrupted runs) — "sqlite" (durable) or "memory"
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
RESUME_INTERRUPTED_RUNS_ON_STARTUP=true

# Similarity search: "model" (local sentence embeddings, downloaded once ~64 MB) or "hashed" (no download)
EMBEDDING_BACKEND=model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=./data/models
