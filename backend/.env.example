# Database
DATABASE_URL=postgresql+asyncpg://placement_user:placement_pass@localhost:5432/placement_portal

# Security
SECRET_KEY=change-this-to-a-64-character-random-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# GLOBAL LLM CONFIGURATION (Fallback if an agent has no specific key)
# Providers: groq | google | openai | anthropic | bedrock
# ============================================================================
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your-fallback-api-key-here

# ============================================================================
# OPTION 3: PER-AGENT PROVIDER, MODEL & API KEY CONFIGURATION
# Insert the respective API key and provider/model for each agent below.
# If an agent's provider or model is left blank, it uses the global settings above.
# ============================================================================

# 1. Resume Agent (Parses and structures resume data)
RESUME_AGENT_PROVIDER=groq
RESUME_AGENT_MODEL=openai/gpt-oss-120b
RESUME_AGENT_API_KEY=your-resume-agent-key

# 2. Coding Analytics Agent (Analyzes GitHub & LeetCode stats)
CODING_ANALYTICS_AGENT_PROVIDER=groq
CODING_ANALYTICS_AGENT_MODEL=openai/gpt-oss-120b
CODING_ANALYTICS_AGENT_API_KEY=your-coding-agent-key

# 3. Skill Gap Agent (Analyzes required vs student skills)
SKILL_GAP_AGENT_PROVIDER=groq
SKILL_GAP_AGENT_MODEL=openai/gpt-oss-120b
SKILL_GAP_AGENT_API_KEY=your-skill-gap-agent-key

# 4. Job Matching Agent (Generates career match advice)
JOB_MATCHING_AGENT_PROVIDER=groq
JOB_MATCHING_AGENT_MODEL=openai/gpt-oss-120b
JOB_MATCHING_AGENT_API_KEY=your-job-matching-agent-key

# 5. Interview Prep Agent (Generates targeted interview questions)
INTERVIEW_AGENT_PROVIDER=groq
INTERVIEW_AGENT_MODEL=openai/gpt-oss-120b
INTERVIEW_AGENT_API_KEY=your-interview-agent-key

# 6. Workflow Coordinator (Plans readiness workflow goals)
COORDINATOR_AGENT_PROVIDER=groq
COORDINATOR_AGENT_MODEL=openai/gpt-oss-120b
COORDINATOR_AGENT_API_KEY=your-coordinator-agent-key

# 7. Mock Interview Evaluator (Evaluates spoken answers & essays)
MOCK_INTERVIEW_PROVIDER=groq
MOCK_INTERVIEW_MODEL=openai/gpt-oss-120b
MOCK_INTERVIEW_API_KEY=your-mock-interview-key

# 8. Mock Practice Coach (Evaluates student practice questions)
MOCK_PRACTICE_PROVIDER=groq
MOCK_PRACTICE_MODEL=openai/gpt-oss-120b
MOCK_PRACTICE_API_KEY=your-mock-practice-key

# 9. NEXUS Chat Assistant (Interactive student chatbot)
CHAT_AGENT_PROVIDER=groq
CHAT_AGENT_MODEL=openai/gpt-oss-120b
CHAT_AGENT_API_KEY=your-chat-agent-key

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000

# File Uploads
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=./uploads

# Agent Config
MAX_RETRIES=3
TOKEN_BUDGET=100000
RUN_TIMEOUT_SECONDS=300

# Coding-platform connectors
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
CONNECTOR_TIMEOUT_SECONDS=10
CODING_DATA_STALE_HOURS=24

# Knowledge base retrieval
KB_BACKEND=postgres_fts

# Run checkpoints
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
RESUME_INTERRUPTED_RUNS_ON_STARTUP=true

# Similarity search
EMBEDDING_BACKEND=model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=./data/models
